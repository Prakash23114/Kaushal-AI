PORT=4000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kaushal_ai?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Google Gemini AI
GOOGLE_GENAI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Email Service (Nodemailer) - Use either OAuth2 or App Password
EMAIL_USER=your_email@gmail.com
# Option A: Gmail OAuth2
CLIENT_ID=your_google_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret
REFRESH_TOKEN=your_oauth2_refresh_token
# Option B: App Password (Alternative to OAuth2)
# EMAIL_PASS=your_gmail_app_password

# Client & OAuth URLs
CLIENT_URL=https://your-frontend-domain.vercel.app
GOOGLE_CALLBACK_URL=https://your-backend-domain.onrender.com/api/auth/google/callback

# Optional: Puppeteer Chromium executable path (for custom Docker / Nixpacks environments)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

